# Скопіюй цей файл у .env і заповни. start.bat зробить це сам при першому запуску.

# Токен бота: https://discord.com/developers/applications -> твій застосунок -> Bot -> Reset Token
DISCORD_TOKEN=

# Гучність за замовчуванням, 0–150 (%)
DEFAULT_VOLUME=50

# Колір embed-ів (hex). Панель «Зараз грає» бере колір із мініатюри треку, цей — для решти повідомлень.
EMBED_COLOR=#8B5CF6

# Необов'язково, для розробки: ID сервера, на якому slash-команди з'являться миттєво.
# Порожньо = глобальна синхронізація (на всіх серверах, але оновлення може йти до години).
GUILD_ID=

# ----- Discord Activity (веб-інтерфейс у голосовому каналі) -----
# Developer Portal -> твій застосунок -> OAuth2: Client ID і Client Secret.
# Без DISCORD_CLIENT_SECRET (і без DEV_MODE) веб-сервер Activity не запускається — бот працює як раніше.
DISCORD_CLIENT_ID=1356648406877208707
DISCORD_CLIENT_SECRET=
# Порт локального веб-сервера (слухає тільки 127.0.0.1; назовні його виставляє cloudflared).
WEB_PORT=8080
# Довгий випадковий рядок для підпису сесій Activity. Порожньо = новий при кожному запуску
# (тоді після перезапуску бота Activity треба відкрити заново). Згенерувати:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Локальна розробка без Discord-авторизації: API приймає ?user=<твій Discord ID>, лише з localhost.
# НІКОЛИ не вмикай разом із тунелем.
DEV_MODE=0
# DEV_MODE: від чийого імені діяти, якщо не передано ?user=
DEV_USER_ID=
